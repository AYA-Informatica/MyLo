# Environment
NODE_ENV=

# PORT
PORT=

# Huggingface
HUGGINGFACE_HUB_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Database Configuration (PROD)
PROD_USERNAME=
PROD_DATABASE=
PROD_PASSWORD=
PROD_HOST=
PROD_PORT=5432
PROD_SSLMODE=true

# Database Configuration (DEV)
DEV_USERNAME=postgres
DEV_DATABASE=
DEV_PASSWORD=
DEV_HOST=postgres
DEV_PORT=5432
DEV_SSLMODE=false

# Database Configuration (TEST)
TEST_USERNAME=postgres
TEST_PASSWORD=
TEST_DATABASE=
TEST_HOST=postgres
TEST_PORT=5432
TEST_SSLMODE=false

# Redis Configuration
# Declare each key exactly once — dotenv is last-wins, so a second block
# redeclaring these silently blanks the values above it.
# `redis` is the Compose service name, resolvable on the mylo-network.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Postgres container bootstrap credentials.
# The postgres image reads these on first boot to create the role and database,
# so they must agree with DEV_USERNAME / DEV_PASSWORD / DEV_DATABASE above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=
# JWT Configuration
JWT_SECRET=
SESSION_SECRET=
# Cloudinary Configuration
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
# Google Passport Strategy Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP Email credentials
SMTP_EMAIL=
APP_PASSWORD= 
