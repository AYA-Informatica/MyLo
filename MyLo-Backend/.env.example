# Environment Configuration
NODE_ENV=

# Port
PORT=

# Public base URL of this API. Used to build unsubscribe links and the logo
# URL embedded in outgoing email, so it must be reachable by mail clients.
BASE_URL=http://localhost:5001

# Huggingface
HUGGINGFACE_HUB_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Database Configuration (PROD)
PROD_USERNAME=
PROD_DATABASE=
PROD_PASSWORD=
PROD_HOST=
PROD_PORT=5432
PROD_SSLMODE=true

# Database Configuration (DEV)
DEV_USERNAME=postgres
DEV_DATABASE=
DEV_PASSWORD=
DEV_HOST=localhost
DEV_PORT=5432
DEV_SSLMODE=false

# Database Configuration (TEST)
TEST_USERNAME=postgres
TEST_PASSWORD=
TEST_DATABASE=
TEST_HOST=localhost
TEST_PORT=5432
TEST_SSLMODE=false

# Redis Configuration
# NOTE: these keys are read once, so declare each exactly once. A second block
# redeclaring REDIS_HOST/REDIS_PORT/REDIS_PASSWORD silently overwrites whatever
# was set above it (dotenv is last-wins) — that is how these values got blanked.
# For local development the Docker Compose stack serves Redis on localhost:6379.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=
SESSION_SECRET=

# Cloudinary Configuration
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# Google Passport Strategy Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Email credentials
SMTP_EMAIL=
APP_PASSWORD= 
