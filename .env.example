# Copy to .env and edit. .env is gitignored; this file is not.

# Required. No default is provided on purpose: a database holding an audit trail
# and readers' recorded questions should not be reachable with a password that
# was in a repository.
POSTGRES_PASSWORD=

POSTGRES_USER=mylo
POSTGRES_DB=mylo

# Where the Gazette PDFs live on the host, mounted read-only into the API
# container so the corpus pipeline can be run against the deployed database.
CORPUS_DIR=./corpus

API_PORT=5001
LOG_LEVEL=info

# Required to expose GET /api/v1/stats. Unset means the endpoint 404s rather
# than serving: a deployment where someone forgot to set a variable is exactly
# the one that should not be publishing its internals.
STATS_TOKEN=
