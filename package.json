{
  "name": "mylo",
  "version": "1.0.0",
  "private": true,
  "description": "MyLo \u2014 making the Rwanda Law Gazette readable, searchable and interactive.",
  "homepage": "https://github.com/AYA-Informatica/MyLo#readme",
  "bugs": {
    "url": "https://github.com/AYA-Informatica/MyLo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AYA-Informatica/MyLo.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @mylo/api",
    "dev:web": "npm run dev -w @mylo/web",
    "build": "npm run build -w @mylo/web",
    "typecheck": "npm run typecheck -w @mylo/api && npm run typecheck -w @mylo/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:init": "node scripts/env-init.mjs",
    "brand:render": "node brand/render.mjs",
    "db:migrate": "npm run migrate -w @mylo/db",
    "db:studio": "npm run studio -w @mylo/db",
    "corpus:build": "npm run ingest:constitution -w @mylo/corpus",
    "corpus:load": "npm run load:corpus -w @mylo/pipeline",
    "eval:threshold": "npm run eval:threshold -w @mylo/eval",
    "eval:sparse": "npm run eval:sparse -w @mylo/eval",
    "eval:retrieval": "npm run eval:retrieval -w @mylo/eval",
    "stack:up": "docker compose -f MyLo-Backend/docker-compose.yml up -d postgres",
    "stack:down": "docker compose -f MyLo-Backend/docker-compose.yml down",
    "stack:logs": "docker compose -f MyLo-Backend/docker-compose.yml logs -f",
    "legacy:dev": "concurrently -n api,web -c cyan,magenta \"npm --prefix MyLo-Backend run dev\" \"npm --prefix MyLo-frontend run dev\"",
    "legacy:install": "npm --prefix MyLo-Backend install && npm --prefix MyLo-frontend install",
    "prepare": "husky",
    "corpus:gazette": "npm run ingest:gazette -w @mylo/corpus --",
    "corpus:load-gazette": "npm run load:gazette -w @mylo/pipeline --",
    "test": "node --test packages/corpus/src/*.test.mjs packages/eval/src/*.test.mjs",
    "corpus:triage": "npm run triage -w @mylo/corpus --",
    "corpus:golden": "npm run golden -w @mylo/corpus --",
    "status:build": "npm run status:build -w @mylo/pipeline --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
